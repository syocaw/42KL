#include <stdio.h>

int	FACTORY(char *arr, int remain, int n, int fac) 
{
	if (fac < remain)		//base case
		remain = FACTORY(arr-1, remain, n+1, fac*(n+1) );  //previously i used arr--, didnt know i could use arr-1 haha
   
	*arr = remain / fac + '0';
	remain = remain % fac;
	return (remain);	//the only value we need this recursive function to remember after altering it
}

int	checkdiagonal(char *arr, int diagonal[], int x)
{
	int flag;
	int sum;
	int n = 0;

	while (n < 10)  
	{
		flag = 0;
		for (int i = 0; i <= 9; i++)
		{
			if (x == 1)
				sum = (arr[i] - '0') + i;		//this is for the northeast diagonal checking

			if (x == 2)
				sum = (arr[i] - '0') - i + 18;		//this is for the southeast diagonal checking

			if (sum == diagonal[n] )
				flag++;
		}

		if(flag > 1)		//if its only 1, means theres no collision in the diagonals, anything more than 1 means collision
			return (0);

		n++;
	}
    return (1);
}

											
